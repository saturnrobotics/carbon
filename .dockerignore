# Excludes for builds whose context is the repository root. Other context roots
# and Dockerfile-specific overrides carry their own tested private-input rules.
# Merged + deduplicated from .gitignore plus Docker-specific entries.

# VCS / CI / project meta
.git
.github
.husky

# Dependencies & build output
node_modules
**/node_modules
**/test-results
**/playwright-report
**/.cert
.turbo
.cache
dist
dist-ssr
build
public/build
public/dist
server/dist
.output
.next
.source
.react-router
.vercel
.trigger
.sst
*.tsbuildinfo
api/index.js*
api/_assets*
vite.config.ts.timestamp*

# Generated (rebuilt during the image build)
packages/locale/locales/**/*.mjs
docs/lib/api-data.generated.ts
docs/lib/tools-data.generated.ts

# Env / secrets — never bake into an image
.env
.envrc
.env.local
.env*.local
.env.dev
.env.development.local
.env.test.local
.env.prod
.env.production
.env.production.local
packages/database/.env
packages/database/supabase/seed.sql
**/secrets/
*.secret

# Editor / tooling / agent scratch
.vscode
.cursor
.windsurf
.idea
.claude
.claude-flow
.superpowers
.carbon-worktree
.ai
.codex
**/.local
**/.terraform
**/*.tfstate*
**/.env*
.mcp.json
opencode.json
.pr-review

# Rust / C++ (cad-engine) build artifacts
**/target/
**/*.rs.bk
**/pkg/
**/build/

# Not needed inside the image
docs
contrib
!contrib/
!contrib/deploying/
!contrib/deploying/knowledge/
!contrib/deploying/knowledge/**
llm

# OS / logs
.DS_Store
*.log

**/__pycache__/
**/*.pyc

# Keep private inputs excluded after the knowledge tooling allow-list above.
# Docker uses the last matching rule, including directory re-inclusions.
**/.local
**/.env*
**/secrets/
**/*.secret
**/.terraform
**/*.tfstate*

# Final private-input filters must follow every source re-inclusion above.
# Keep this block in each context root and Dockerfile-specific override: Docker
# does not combine their rules. Context verification tests the actual builder.
**/.fork/local
**/.env*
**/.local
**/.secrets
**/secrets
**/*.secret
**/.terraform
**/*.tfstate
**/*.tfstate.*
**/.terraform.tfstate.lock.info
**/*.tfplan
**/*.tfplan.*
**/tfplan
**/tfplan.*
**/*.tfvars
**/*.tfvars.json
**/.terraformrc
**/terraform.rc
**/credentials.tfrc.json
**/crash.log
**/crash.*.log
**/.docker
**/.buildx
**/.buildkit
**/.docker-build
**/.docker-cache
**/.docker-images
**/.docker-data
**/*.docker.tar
**/*.docker.tar.gz
**/*.docker.tar.zst
**/*.oci.tar
**/*.oci.tar.gz
**/*.oci.tar.zst
**/.cert
**/__pycache__
**/*.pyc
**/test-results
**/playwright-report
**/.codex
**/.mcp.json
