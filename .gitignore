# Private environment inputs at every depth. Only reviewed example templates
# belong in Git; an example suffix does not make real credentials public.
.env*
!.env.example
!.env.*.example
!.envrc.example
packages/database/supabase/seed.sql

# Terraform runtime state, plans, provider downloads and private variable inputs.
# Keep authored .tf/.tf.json, .terraform.lock.hcl and *.tfvars*.example visible.
.terraform/
*.tfstate
*.tfstate.*
.terraform.tfstate.lock.info
*.tfplan
*.tfplan.*
tfplan
tfplan.*
*.tfvars
*.tfvars.json
.terraformrc
terraform.rc
credentials.tfrc.json
crash.log
crash.*.log

# Local Docker authentication, build caches, image exports and runtime volumes.
# Use these directories (or .fork/local/) for arbitrarily named build outputs.
# Dockerfiles, Compose source, ordinary JSON and authored tar fixtures stay visible.
.docker/
.buildx/
.buildkit/
.docker-build/
.docker-cache/
.docker-images/
.docker-data/
*.docker.tar
*.docker.tar.gz
*.docker.tar.zst
*.oci.tar
*.oci.tar.gz
*.oci.tar.zst
.local/
.secrets/
secrets/
*.secret

# Private self-host inputs, rendered configuration, credentials, state, and backups.
# Tracked deployment templates must contain only generic examples.
/contrib/deploying/gcp-tailscale/.local/
/contrib/deploying/gcp-tailscale/**/__pycache__/
/contrib/deploying/gcp-tailscale/**/*.py[cod]

# Rust
**/target/
**/*.rs.bk
**/pkg/

# C++ (cad-engine)
**/build/
!**/build/.gitkeep
.orcka
**/supabase/snippets

# Worktree-isolated dev environment
.carbon-worktree
.superpowers

# Agent scratch — local-only, never commit
apps/*/portless.json
packages/database/supabase/snippets/**
.pr-review

# Agent harness dirs. Source of truth is .claude/rules/ and .claude/skills/ (tracked).
# .codex/ is generated by .ai/scripts/install-skills.sh (copied from .claude/) — local-only.
.agents/
.claude/*
!.claude/rules/
!.claude/skills/
.codex/

# External skills manifest — locally resolved from skill sources, not committed
skills-lock.json

# Editor/IDE settings — local, not source
.vscode/

# .ai/ scratch — runtime, not source
.ai/scratch/
.ai/daily-notes/

# Daily notes — runtime scratch, not source
memory/daily-notes/

# Loop run artifacts (@carbon/harness RUNS_DIR).
# Volatile files (screenshots, raw event log) are excluded; durable run records
# (binding, ledger, outcome) are committed back to main after each build so any
# agent can inspect history and resume partial work without the worktree.
.ai/runs/*/screenshots/
.ai/runs/*/run.log.jsonl
.ai/runs/*/.tmp/

# Legacy llm/ — consolidated into .ai/ (docs, specs, runs)
llm/

# Generated MCP/Carbon API manifest — 1.3MB, rewritten wholesale on every run.
# Produced by `pnpm generate:mcp` (postinstall + turbo). The committed record of
# the published contract is its small companion, tool-manifest.digest.json.
apps/erp/app/routes/api+/mcp+/lib/tool-metadata.json

# Runtime TLS certificates and browser reports can contain private data at any depth.
.cert/
test-results/
playwright-report/

**/__pycache__/
**/*.pyc

# Fork execution state is private/local; durable policy and decisions live in .fork/.
.fork/local/
.ai/state.db
