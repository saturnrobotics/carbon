# OCCT builds use apps/assembler as their context root. The repository root's
# ignore file and the application Dockerfile override do not apply here.
# Preserve occt-patches/, C++/Rust source, Dockerfiles and reviewed templates.
**/target
**/node_modules
**/build
.git

# Final private-input filters must follow every source re-inclusion above.
# Keep this block in each context root and Dockerfile-specific override: Docker
# does not combine their rules. Context verification tests the actual builder.
**/.fork/local
**/.env*
**/.local
**/.secrets
**/secrets
**/*.secret
**/.terraform
**/*.tfstate
**/*.tfstate.*
**/.terraform.tfstate.lock.info
**/*.tfplan
**/*.tfplan.*
**/tfplan
**/tfplan.*
**/*.tfvars
**/*.tfvars.json
**/.terraformrc
**/terraform.rc
**/credentials.tfrc.json
**/crash.log
**/crash.*.log
**/.docker
**/.buildx
**/.buildkit
**/.docker-build
**/.docker-cache
**/.docker-images
**/.docker-data
**/*.docker.tar
**/*.docker.tar.gz
**/*.docker.tar.zst
**/*.oci.tar
**/*.oci.tar.gz
**/*.oci.tar.zst
**/.cert
**/__pycache__
**/*.pyc
**/test-results
**/playwright-report
**/.codex
**/.mcp.json
