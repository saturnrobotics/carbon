    "test": "vitest run --passWithNoTests=false",
    "typecheck": "tsgo --noEmit"
  },
  "dependencies": {
    "@carbon/knowledge": "workspace:*"
  },
  "devDependencies": {
    "@carbon/config": "workspace:*",
    "@types/node": "catalog:",
    "tsup": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
