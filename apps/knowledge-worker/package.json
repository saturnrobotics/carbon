{
  "name": "knowledge-worker",
  "version": "0.0.0",
  "type": "module",
  "private": true,
  "sideEffects": false,
  "scripts": {
    "build": "tsup --out-dir dist",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "test": "vitest run --passWithNoTests=false",
    "typecheck": "tsgo --noEmit"
  },
  "dependencies": {
    "@carbon/knowledge": "workspace:*",
    "@google-cloud/storage": "7.16.0",
    "inngest": "3.54.0",
    "pg": "8.20.0"
  },
  "devDependencies": {
    "@carbon/config": "workspace:*",
    "@types/node": "catalog:",
    "tsup": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "@types/pg": "8.15.6"
  }
}
