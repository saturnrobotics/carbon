# Reviewed multi-platform digest. base-images.json is the record;
# test_base_image_pins.py keeps every knowledge Dockerfile equal to it.
ARG NODE_IMAGE=node:22-alpine@sha256:c610fcdfb1d5b4740dd70c284ed3cb16bb857e0f7166196e36a5501df7a3aa32
FROM ${NODE_IMAGE} AS pruner
WORKDIR /repo
RUN corepack enable
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml .npmrc turbo.json ./
COPY apps ./apps
COPY packages ./packages
COPY patches ./patches
RUN corepack pnpm dlx turbo@2.9.6 prune knowledge-worker --docker

FROM ${NODE_IMAGE} AS builder
WORKDIR /repo
RUN corepack enable
COPY --from=pruner /repo/out/json/ ./
RUN pnpm install --frozen-lockfile --ignore-scripts
COPY --from=pruner /repo/out/full/ ./
COPY LICENSE ./LICENSE
RUN pnpm --filter knowledge-worker build
RUN pnpm --filter knowledge-worker deploy --prod --legacy --ignore-scripts /runtime

FROM ${NODE_IMAGE} AS runtime-base
WORKDIR /app
ENV NODE_ENV=production
ENV KNOWLEDGE_RELEASE_PROFILE=manual-v1
RUN apk add --no-cache poppler-utils tesseract-ocr tesseract-ocr-data-eng
COPY --from=builder /runtime ./
COPY LICENSE ./LICENSE

FROM runtime-base AS e2e
RUN apk add --no-cache font-dejavu
COPY contrib/deploying/knowledge/parser-container-server.mjs /usr/local/bin/parser-container-server.mjs
COPY contrib/deploying/knowledge/images-storage-emulator-proxy.mjs /usr/local/bin/images-storage-emulator-proxy.mjs
EXPOSE 8080
CMD ["node", "/usr/local/bin/parser-container-server.mjs"]

FROM runtime-base AS runtime
CMD ["node", "dist/parser-job.js"]
