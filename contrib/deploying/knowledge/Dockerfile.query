FROM node:22-alpine AS pruner
WORKDIR /repo
RUN corepack enable
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml .npmrc turbo.json ./
COPY apps ./apps
COPY packages ./packages
COPY patches ./patches
RUN corepack pnpm dlx turbo@2.9.6 prune knowledge-query --docker

FROM node:22-alpine AS builder
WORKDIR /repo
RUN corepack enable
COPY --from=pruner /repo/out/json/ ./
RUN pnpm install --frozen-lockfile --ignore-scripts
COPY --from=pruner /repo/out/full/ ./
RUN pnpm --filter knowledge-query build
RUN pnpm --filter knowledge-query deploy --prod --legacy --ignore-scripts /runtime

FROM node:22-alpine AS runtime
WORKDIR /app
ENV NODE_ENV=production
ENV KNOWLEDGE_RELEASE_PROFILE=manual-v1
ENV PORT=8080
COPY --from=builder /runtime ./
EXPOSE 8080
CMD ["node", "dist/index.js"]
