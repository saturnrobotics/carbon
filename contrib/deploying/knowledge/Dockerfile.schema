FROM node:22-alpine AS pruner
WORKDIR /repo
RUN corepack enable
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml .npmrc turbo.json ./
COPY apps ./apps
COPY packages ./packages
COPY patches ./patches
RUN corepack pnpm dlx turbo@2.9.6 prune @carbon/knowledge --docker

FROM node:22-alpine AS builder
WORKDIR /repo
RUN corepack enable
COPY --from=pruner /repo/out/json/ ./
RUN pnpm install --frozen-lockfile --ignore-scripts
COPY --from=pruner /repo/out/full/ ./
RUN pnpm exec tsup packages/knowledge/scripts/migrate.ts --format esm --no-splitting --out-dir schema
RUN pnpm --filter @carbon/knowledge deploy --prod --legacy --ignore-scripts /runtime

FROM node:22-alpine AS runtime
WORKDIR /app
ENV NODE_ENV=production
COPY --from=builder /runtime ./
COPY --from=builder /repo/schema ./schema
CMD ["node", "schema/migrate.mjs"]
