# Reviewed multi-platform digest. base-images.json is the record;
# test_base_image_pins.py keeps every knowledge Dockerfile equal to it.
ARG NODE_IMAGE=node:22-alpine@sha256:c610fcdfb1d5b4740dd70c284ed3cb16bb857e0f7166196e36a5501df7a3aa32
FROM ${NODE_IMAGE} AS pruner
WORKDIR /repo
RUN corepack enable
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml .npmrc turbo.json ./
COPY apps ./apps
COPY packages ./packages
COPY patches ./patches
RUN corepack pnpm dlx turbo@2.9.6 prune knowledge --docker

FROM ${NODE_IMAGE} AS builder
WORKDIR /repo
RUN corepack enable
COPY --from=pruner /repo/out/json/ ./
RUN pnpm install --frozen-lockfile --ignore-scripts
COPY --from=pruner /repo/out/full/ ./
COPY LICENSE ./LICENSE
RUN pnpm --filter knowledge build
RUN pnpm --filter knowledge deploy --prod --legacy --ignore-scripts /runtime

FROM builder AS e2e
WORKDIR /repo/apps/knowledge
ENV NODE_ENV=test
ENV KNOWLEDGE_RELEASE_PROFILE=manual-v1
ENV PORT=4200
RUN apk add --no-cache openssl
COPY contrib/deploying/knowledge/images-web-e2e.mjs /usr/local/bin/images-web-e2e.mjs
EXPOSE 4200
CMD ["node", "/usr/local/bin/images-web-e2e.mjs"]

FROM ${NODE_IMAGE} AS runtime
WORKDIR /app
ENV NODE_ENV=production
ENV KNOWLEDGE_RELEASE_PROFILE=manual-v1
ENV PORT=8080
COPY --from=builder /runtime ./
COPY LICENSE ./LICENSE
RUN rm -rf app tests .react-router
EXPOSE 8080
CMD ["node", "node_modules/@react-router/serve/bin.js", "build/server/index.js"]
