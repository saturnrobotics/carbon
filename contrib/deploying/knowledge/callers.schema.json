{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/schemas/knowledge-trusted-callers-v1.json",
  "title": "Knowledge trusted caller configuration",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "receiver", "callers"],
  "properties": {
    "version": { "const": 1 },
    "receiver": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "audience"],
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 2048 },
        "audience": { "type": "string", "minLength": 1, "maxLength": 2048 }
      }
    },
    "callers": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "callerId",
          "serviceAccountSubject",
          "sourceIapAudience",
          "operations",
          "capabilities",
          "requiredAccessLevels"
        ],
        "properties": {
          "callerId": { "type": "string", "minLength": 1, "maxLength": 2048 },
          "serviceAccountSubject": { "type": "string", "minLength": 1, "maxLength": 2048 },
          "sourceIapAudience": { "type": "string", "minLength": 1, "maxLength": 2048 },
          "operations": {
            "type": "array",
            "minItems": 1,
            "maxItems": 100,
            "items": { "type": "string", "minLength": 1, "maxLength": 2048 }
          },
          "capabilities": {
            "type": "array",
            "maxItems": 100,
            "items": { "type": "string", "minLength": 1, "maxLength": 2048 }
          },
          "requiredAccessLevels": {
            "type": "array",
            "maxItems": 20,
            "items": { "type": "string", "minLength": 1, "maxLength": 2048 }
          }
        }
      }
    }
  }
}
