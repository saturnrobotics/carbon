{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/schemas/knowledge-trusted-callers-v1.json",
  "title": "Knowledge trusted caller configuration",
  "description": "Mirrors trustedCallerConfigurationSchema in packages/knowledge/src/identity.server.ts. Subject uniqueness across callers is enforced by the runtime schema and validate-callers.ts, not expressible here.",
  "$defs": {
    "boundedString": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048,
      "pattern": "\\S"
    }
  },
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "receiver", "callers"],
  "properties": {
    "version": { "const": 1 },
    "receiver": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "audience"],
      "properties": {
        "id": { "$ref": "#/$defs/boundedString" },
        "audience": { "$ref": "#/$defs/boundedString" }
      }
    },
    "callers": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "callerId",
          "serviceAccountSubject",
          "sourceIapAudience",
          "operations",
          "capabilities",
          "requiredAccessLevels"
        ],
        "properties": {
          "callerId": { "$ref": "#/$defs/boundedString" },
          "serviceAccountSubject": { "$ref": "#/$defs/boundedString" },
          "sourceIapAudience": { "$ref": "#/$defs/boundedString" },
          "operations": {
            "type": "array",
            "minItems": 1,
            "maxItems": 100,
            "items": { "$ref": "#/$defs/boundedString" }
          },
          "capabilities": {
            "type": "array",
            "maxItems": 100,
            "items": { "$ref": "#/$defs/boundedString" }
          },
          "requiredAccessLevels": {
            "type": "array",
            "maxItems": 20,
            "items": { "$ref": "#/$defs/boundedString" }
          }
        }
      }
    }
  }
}
