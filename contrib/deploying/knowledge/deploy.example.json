{
  "schema_version": 1,
  "project": "<project-id>",
  "region": "<region>",
  "source_repo_url": "https://github.com/<owner>/<repository>",
  "image_repository": "<region>-docker.pkg.dev/<project-id>/knowledge",
  "pg_service": "knowledge-operator",
  "services": {
    "knowledge-schema": {
      "service_account": "knowledge-migration@<project-id>.iam.gserviceaccount.com",
      "environment": {},
      "secrets": {
        "KNOWLEDGE_MIGRATION_DATABASE_URL": "projects/<project-id>/secrets/knowledge-migration-db-url/versions/<version-number>"
      },
      "resources": {
        "cpu": "1",
        "memory": "512Mi"
      },
      "max_instances": 2,
      "concurrency": 1,
      "network": "knowledge-private",
      "subnetwork": "knowledge-runtime",
      "egress": "all-traffic"
    },
    "knowledge-parser": {
      "service_account": "knowledge-parser@<project-id>.iam.gserviceaccount.com",
      "environment": {},
      "secrets": {},
      "resources": {
        "cpu": "1",
        "memory": "1Gi"
      },
      "max_instances": 2,
      "concurrency": 1,
      "network": "knowledge-private",
      "subnetwork": "knowledge-runtime",
      "egress": "all-traffic"
    },
    "knowledge-query": {
      "service_account": "knowledge-query@<project-id>.iam.gserviceaccount.com",
      "environment": {
        "KNOWLEDGE_BUSINESS_TIMEZONE": "Etc/UTC",
        "KNOWLEDGE_MANUAL_SOURCE_JSON": "{\"sourceId\":\"<manual-source-id>\",\"displayName\":\"Manual library\"}",
        "KNOWLEDGE_PORTAL_ORIGIN": "<knowledge-portal-origin>",
        "KNOWLEDGE_RELEASE_PROFILE": "manual-v1",
        "KNOWLEDGE_TRUSTED_CALLERS_JSON": "<knowledge-trusted-callers-json>"
      },
      "secrets": {
        "KNOWLEDGE_READ_DATABASE_URL": "projects/<project-id>/secrets/knowledge-read-db-url/versions/<version-number>",
        "KNOWLEDGE_REDIS_URL": "projects/<project-id>/secrets/knowledge-redis-url/versions/<version-number>"
      },
      "resources": {
        "cpu": "1",
        "memory": "512Mi"
      },
      "max_instances": 2,
      "concurrency": 20,
      "network": "knowledge-private",
      "subnetwork": "knowledge-runtime",
      "egress": "all-traffic"
    },
    "knowledge-ingest": {
      "service_account": "knowledge-ingest@<project-id>.iam.gserviceaccount.com",
      "environment": {
        "KNOWLEDGE_AUTOMATION_USER_ID": "<knowledge-automation-user-id>",
        "KNOWLEDGE_IDENTITY_URL": "<knowledge-identity-url>",
        "KNOWLEDGE_MACHINE_CALLERS_JSON": "<knowledge-machine-callers-json>",
        "KNOWLEDGE_MANUAL_SOURCE_JSON": "{\"sourceId\":\"<manual-source-id>\",\"displayName\":\"Manual library\"}",
        "KNOWLEDGE_OBJECT_BUCKET": "<knowledge-object-bucket>",
        "KNOWLEDGE_PARSER_JOB": "<knowledge-parser-job>",
        "KNOWLEDGE_PARSER_LOCATION": "<knowledge-parser-location>",
        "KNOWLEDGE_PARSER_OUTPUT_BUCKET": "<knowledge-parser-output-bucket>",
        "KNOWLEDGE_PARSER_PROJECT": "<knowledge-parser-project>",
        "KNOWLEDGE_RELEASE_PROFILE": "manual-v1",
        "KNOWLEDGE_TRUSTED_CALLERS_JSON": "<knowledge-trusted-callers-json>"
      },
      "secrets": {
        "INNGEST_SIGNING_KEY": "projects/<project-id>/secrets/knowledge-inngest-signing-key/versions/<version-number>",
        "KNOWLEDGE_INGEST_DATABASE_URL": "projects/<project-id>/secrets/knowledge-ingest-db-url/versions/<version-number>",
        "KNOWLEDGE_READ_DATABASE_URL": "projects/<project-id>/secrets/knowledge-read-db-url/versions/<version-number>",
        "KNOWLEDGE_REVIEW_DATABASE_URL": "projects/<project-id>/secrets/knowledge-review-db-url/versions/<version-number>"
      },
      "resources": {
        "cpu": "1",
        "memory": "512Mi"
      },
      "max_instances": 2,
      "concurrency": 20,
      "network": "knowledge-private",
      "subnetwork": "knowledge-runtime",
      "egress": "all-traffic"
    },
    "knowledge-retention": {
      "service_account": "knowledge-maintenance@<project-id>.iam.gserviceaccount.com",
      "environment": {
        "KNOWLEDGE_OBJECT_BUCKET": "<knowledge-object-bucket>"
      },
      "secrets": {
        "KNOWLEDGE_MAINTENANCE_DATABASE_URL": "projects/<project-id>/secrets/knowledge-maintenance-db-url/versions/<version-number>"
      },
      "resources": {
        "cpu": "1",
        "memory": "512Mi"
      },
      "max_instances": 2,
      "concurrency": 1,
      "network": "knowledge-private",
      "subnetwork": "knowledge-runtime",
      "egress": "all-traffic"
    },
    "knowledge-web": {
      "service_account": "knowledge-web@<project-id>.iam.gserviceaccount.com",
      "environment": {
        "KNOWLEDGE_COMPANY_ID": "<knowledge-company-id>",
        "KNOWLEDGE_MANUAL_SOURCE_JSON": "{\"sourceId\":\"<manual-source-id>\",\"displayName\":\"Manual library\"}",
        "KNOWLEDGE_QUERY_URL": "<knowledge-query-url>",
        "KNOWLEDGE_RELEASE_PROFILE": "manual-v1",
        "KNOWLEDGE_WEB_ORIGIN": "<knowledge-web-origin>",
        "KNOWLEDGE_WORKER_URL": "<knowledge-worker-url>"
      },
      "secrets": {},
      "resources": {
        "cpu": "1",
        "memory": "512Mi"
      },
      "max_instances": 2,
      "concurrency": 20,
      "network": "knowledge-private",
      "subnetwork": "knowledge-runtime",
      "egress": "all-traffic"
    }
  },
  "database_ca_secret": "projects/<project-id>/secrets/knowledge-source-database-ca/versions/<version-number>"
}
