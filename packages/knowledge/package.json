{
  "name": "@carbon/knowledge",
  "version": "0.0.0",
  "type": "module",
  "private": true,
  "sideEffects": false,
  "exports": {
    ".": "./src/contracts.ts",
    "./database.server": "./src/database.server.ts",
    "./documents.server": "./src/documents.server.ts",
    "./identity.server": "./src/identity.server.ts",
    "./migrations.server": "./src/migrations.server.ts",
    "./schema-contract": "./src/schema-contract.ts",
    "./commands/ticket": "./src/commands/ticket.ts",
    "./commands/ticket.browser": "./src/commands/ticket.browser.ts",
    "./commands/procurement": "./src/commands/procurement.ts",
    "./intake": "./src/intake/intake.server.ts",
    "./intake/extraction": "./src/intake/extraction.server.ts",
    "./intake/reconciliation": "./src/intake/reconciliation.ts",
    "./intake/publish.server": "./src/intake/publish.server.ts",
    "./sources/drive.server": "./src/sources/drive.server.ts",
    "./sources/drive-publication.server": "./src/sources/drive-publication.server.ts",
    "./indexing/indexer.server": "./src/indexing/indexer.server.ts",
    "./indexing/outbox.server": "./src/indexing/outbox.server.ts",
    "./test": "./src/test/synthetic.ts",
    "./test/database": "./src/test/database.ts",
    "./identity-store.server": "./src/identity-store.server.ts",
    "./budgets.server": "./src/budgets.server.ts",
    "./retention.server": "./src/retention.server.ts",
    "./query": "./src/query/answer.server.ts",
    "./query/router": "./src/query/router.ts",
    "./cache": "./src/cache/cache.server.ts",
    "./cache/epochs.server": "./src/cache/epochs.server.ts",
    "./cache/redis.server": "./src/cache/redis.server.ts",
    "./retrieval/lexical.server": "./src/retrieval/lexical.server.ts",
    "./retrieval/vector.server": "./src/retrieval/vector.server.ts",
    "./retrieval/fusion": "./src/retrieval/fusion.ts",
    "./retrieval/evidence": "./src/retrieval/evidence.ts",
    "./query/vertex.server": "./src/query/vertex.server.ts",
    "./sources/registry.server": "./src/sources/registry.server.ts",
    "./entities/resolve": "./src/entities/resolve.ts",
    "./query/embedding.server": "./src/query/embedding.server.ts",
    "./telemetry": "./src/telemetry.ts",
    "./query/deadline.server": "./src/query/deadline.server.ts",
    "./query/request-boundary.server": "./src/query/request-boundary.server.ts",
    "./release-profile": "./src/release-profile.ts"
  },
  "scripts": {
    "clean": "rimraf .turbo node_modules dist",
    "evaluate": "tsx scripts/evaluate.ts",
    "generate:types": "tsx scripts/generate-types.ts",
    "migration:new": "tsx scripts/migration-new.ts",
    "migrate:test": "tsx scripts/migrate.ts --disposable",
    "test": "vitest run --passWithNoTests=false",
    "test:integration": "vitest run --config vitest.integration.config.ts --passWithNoTests=false",
    "typecheck": "tsgo --noEmit",
    "verify:deployment": "node -e \"throw new Error('Knowledge deployment verification is not implemented; complete Task 24 first')\"",
    "verify:security": "tsx scripts/verify-security.ts"
  },
  "dependencies": {
    "@internationalized/date": "catalog:",
    "google-auth-library": "11.0.2",
    "pg": "8.20.0",
    "zod": "catalog:",
    "ioredis": "5.10.1"
  },
  "devDependencies": {
    "@carbon/config": "workspace:*",
    "@types/node": "catalog:",
    "@types/pg": "8.15.6",
    "rimraf": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
