msgid "A follow-up question keeps the evidence shown here in context."
msgstr "एक अनुवर्ती प्रश्न यहाँ दिखाए गए साक्ष्य को संदर्भ में रखता है।"

msgid "Access to this document was revoked."
msgstr "इस दस्तावेज़ तक पहुंच रद्द कर दी गई।"

msgid "Acknowledge the changed evidence before publishing."
msgstr "प्रकाशित करने से पहले बदले गए सबूत को स्वीकार करें।"

msgid "Add a document"
msgstr "एक दस्तावेज़ जोड़ें"

msgid "Additional proposed fields"
msgstr "अतिरिक्त प्रस्तावित क्षेत्र"

msgid "Also proposed"
msgstr "भी प्रस्तावित"

msgid "Answer"
msgstr "उत्तर"

msgid "Back to company knowledge"
msgstr "कंपनी ज्ञान पर वापस जाएं"

msgid "Back to manual search"
msgstr "मैनुअल खोज पर वापस जाएं"

msgid "Captured"
msgstr "कैप्चर किया गया"

msgid "Captured document"
msgstr "कैप्चर किया गया दस्तावेज़"

msgid "Check freshness"
msgstr "ताज़ापन जांचें"

msgid "Choices"
msgstr "विकल्प"

msgid "Choose either a file or a URL, not both."
msgstr "एक फ़ाइल या URL चुनें, दोनों नहीं।"

msgid "Choose one PDF, image, photo, or HTTPS address."
msgstr "एक PDF, छवि, फ़ोटो, या HTTPS पता चुनें।"

msgid "Company knowledge"
msgstr "कंपनी ज्ञान"

#. placeholder {0}: evidence.length
msgid "Composing an answer from {0} evidence blocks…"
msgstr "{0} साक्ष्य ब्लॉक से उत्तर तैयार किया जा रहा है…"

msgid "Confirm removal"
msgstr "हटाने की पुष्टि करें"

msgid "Confirm this field against the source evidence."
msgstr "इस क्षेत्र को स्रोत साक्ष्य के विरुद्ध पुष्टि करें।"

msgid "Corrections are saved. The document can be published."
msgstr "सुधार सहेज दिए गए हैं। दस्तावेज़ प्रकाशित किया जा सकता है।"

msgid "Current version"
msgstr "वर्तमान संस्करण"

msgid "Document"
msgstr "दस्तावेज़"

msgid "Download original"
msgstr "मूल डाउनलोड करें"

msgid "Download original · page {page}"
msgstr "मूल डाउनलोड करें · पृष्ठ {page}"

msgid "Drag and drop a PDF or image here, or choose a file."
msgstr "यहाँ एक PDF या छवि खींचें और छोड़ें, या एक फ़ाइल चुनें।"

msgid "Drive sources are enrolled by an administrator with a read-only connector credential held in Secret Manager. Signing into this portal does not authorize Drive access: a document is delivered only after a live check with your own Drive permissions."
msgstr "Drive स्रोतों को Secret Manager में रखे गए केवल-पढ़ने के लिए कनेक्टर क्रेडेंशियल के साथ एक प्रशासक द्वारा पंजीकृत किया जाता है। इस पोर्टल में साइन इन करना Drive एक्सेस को अधिकृत नहीं करता है: एक दस्तावेज़ केवल आपकी स्वयं की Drive की अनुमतियों के साथ एक लाइव जांच के बाद वितरित किया जाता है।"

msgid "Existing item"
msgstr "मौजूदा आइटम"

msgid "Extracted text anchored to page numbers. Page images are not available for this document; download the original to see the layout."
msgstr "पृष्ठ संख्या के लिए लंगर वाला निकाला गया पाठ। इस दस्तावेज़ के लिए पृष्ठ छवियां उपलब्ध नहीं हैं; लेआउट देखने के लिए मूल डाउनलोड करें।"

msgid "Extracting"
msgstr "निष्कर्षण जारी है"

msgid "Extraction failed"
msgstr "निष्कर्षण विफल रहा"

msgid "Fetched from"
msgstr "से लाया गया"

msgid "Find the right manual."
msgstr "सही मैनुअल खोजें।"

msgid "Google Drive sources"
msgstr "Google Drive स्रोत"

msgid "I reviewed this evidence"
msgstr "मैंने इस सबूत की समीक्षा की है"

msgid "Intake review"
msgstr "प्रवेश समीक्षा"

msgid "Item association"
msgstr "आइटम संबंध"

msgid "Item lookup is not available for this library. The document can still be published as a generic document."
msgstr "इस लाइब्रेरी के लिए आइटम लुकअप उपलब्ध नहीं है। दस्तावेज़ को अभी भी एक सामान्य दस्तावेज़ के रूप में प्रकाशित किया जा सकता है।"

msgid "Item lookup is unavailable right now."
msgstr "आइटम लुकअप अभी उपलब्ध नहीं है।"

msgid "Library"
msgstr "लाइब्रेरी"

msgid "Library and access"
msgstr "लाइब्रेरी और पहुंच"

msgid "Link this document to one existing item, or keep it as a generic document. Linking never creates or changes items."
msgstr "इस दस्तावेज़ को एक मौजूदा आइटम से जोड़ें, या इसे एक सामान्य दस्तावेज़ के रूप में रखें। जोड़ना कभी आइटम बनाता या बदलता नहीं है।"

msgid "Live record"
msgstr "लाइव रिकॉर्ड"

msgid "Machine"
msgstr "मशीन"

msgid "Manual file"
msgstr "मैनुअल फ़ाइल"

msgid "Manual search is unavailable."
msgstr "मैनुअल खोज उपलब्ध नहीं है।"

msgid "Manufacturer"
msgstr "निर्माता"

msgid "Manufacturer, part number, revision, machine, or keyword"
msgstr "निर्माता, पार्ट नंबर, रिवीजन, मशीन, या कीवर्ड"

msgid "Needs review"
msgstr "समीक्षा की आवश्यकता है"

msgid "No evidence on any page"
msgstr "किसी भी पृष्ठ पर कोई साक्ष्य नहीं"

msgid "No item association (generic document)"
msgstr "कोई आइटम संबद्धता नहीं (सामान्य दस्तावेज़)"

msgid "No matching items."
msgstr "कोई मेल खाने वाले आइटम नहीं।"

msgid "No matching manuals found."
msgstr "कोई मेल खाने वाले मैनुअल नहीं मिले।"

msgid "No text has been extracted yet."
msgstr "अभी तक कोई पाठ निकाला नहीं गया है।"

msgid "Not set"
msgstr "सेट नहीं है"

msgid "Not yet decided. Saving the review records your choice."
msgstr "अभी तय नहीं हुआ है। समीक्षा को सहेजने से आपकी पसंद दर्ज होती है।"

#. placeholder {0}: entity.observedAt
msgid "Observed {0}"
msgstr "देखा गया {0}"

msgid "Only public HTTPS addresses are fetched, through the server's fetch policy, and the fetched copy is stored immutably."
msgstr "केवल सार्वजनिक HTTPS पते प्राप्त किए जाते हैं, सर्वर की प्राप्ति नीति के माध्यम से, और प्राप्त प्रति को अपरिवर्तनीय रूप से संग्रहीत किया जाता है।"

msgid "Only the first candidates are shown; narrow the search."
msgstr "केवल पहले उम्मीदवार दिखाए जाते हैं; खोज को संकीर्ण करें।"

msgid "Open record"
msgstr "खुला रिकॉर्ड"

#. placeholder {0}: selected?.classification ?? ""
msgid "Owner: {actorId}. Access: {0}. Readers of this library can find the document once it is reviewed and published."
msgstr "स्वामी: {actorId}। पहुंच: {0}। इस लाइब्रेरी के पाठक दस्तावेज़ को तब पा सकते हैं जब वह समीक्षित और प्रकाशित हो।"

#. placeholder {0}: source.page
msgid "page {0}"
msgstr "पृष्ठ {0}"

msgid "Page {page}"
msgstr "पृष्ठ {page}"

msgid "Page not found."
msgstr "पृष्ठ नहीं मिला।"

msgid "Part number"
msgstr "पार्ट संख्या"

msgid "Part number, MPN, or name"
msgstr "पार्ट संख्या, MPN, या नाम"

msgid "Partial source answer"
msgstr "आंशिक स्रोत उत्तर"

msgid "PDF and image files are captured with their immutable object version before extraction."
msgstr "PDF और चित्र फाइलों को निकालने से पहले उनके अपरिवर्तनीय वस्तु संस्करण के साथ कैप्चर किया जाता है।"

msgid "Proposed fields"
msgstr "प्रस्तावित क्षेत्र"

msgid "Proposed fields are ready. Confirm or correct them, then save."
msgstr "प्रस्तावित क्षेत्र तैयार हैं। उन्हें पुष्टि करें या सुधारें, फिर सहेजें।"

#. placeholder {0}: model.proposed[field]
msgid "Proposed: {0}"
msgstr "प्रस्तावित: {0}"

msgid "Publish manual"
msgstr "मैनुअल प्रकाशित करें"

msgid "Published"
msgstr "प्रकाशित"

msgid "Remove manual"
msgstr "मैनुअल निकालें"

msgid "Remove this manual?"
msgstr "इस मैनुअल को निकालें?"

msgid "Request unavailable"
msgstr "अनुरोध अनुपलब्ध है"

msgid "Review document"
msgstr "दस्तावेज़ की समीक्षा करें"

msgid "Reviewed"
msgstr "समीक्षित"

msgid "Revision"
msgstr "रिवीजन"

msgid "Save review"
msgstr "समीक्षा सहेजें"

msgid "Save the review before publishing."
msgstr "प्रकाशन से पहले समीक्षा को सहेजें।"

msgid "Saved correction"
msgstr "सहेजा गया सुधार"

msgid "Search items"
msgstr "आइटम खोजें"

msgid "Search manuals"
msgstr "मैनुअल खोजें"

msgid "Search published company manuals by manufacturer, part number, revision, machine, or keyword. Open the exact original version from every result."
msgstr "निर्माता, पार्ट संख्या, रिवीजन, मशीन, या कीवर्ड द्वारा प्रकाशित कंपनी मैनुअल खोजें। प्रत्येक परिणाम से सटीक मूल संस्करण खोलें।"

msgid "Searching authorized sources…"
msgstr "अधिकृत स्रोत खोजे जा रहे हैं…"

msgid "Searching…"
msgstr "खोज रहे हैं…"

msgid "see evidence"
msgstr "साक्ष्य देखें"

msgid "Selected: {fileName}"
msgstr "चयनित: {fileName}"

msgid "Show evidence ({evidenceCount})"
msgstr "साक्ष्य दिखाएं ({evidenceCount})"

msgid "Some authorized manuals were unavailable."
msgstr "कुछ अधिकृत मैनुअल अनुपलब्ध थे।"

msgid "Some sources did not answer; results may be partial."
msgstr "कुछ स्रोतों ने उत्तर नहीं दिया; परिणाम आंशिक हो सकते हैं।"

msgid "Source details"
msgstr "स्रोत विवरण"

msgid "Source evidence"
msgstr "स्रोत साक्ष्य"

msgid "Source pages"
msgstr "स्रोत पृष्ठ"

#. placeholder {0}: entity.sourceRevision
msgid "Source revision: {0}"
msgstr "स्रोत रिवीजन: {0}"

msgid "Source unavailable"
msgstr "स्रोत अनुपलब्ध है"

msgid "Source URL"
msgstr "स्रोत URL"

msgid "Sources"
msgstr "स्रोत"

msgid "Start a new question"
msgstr "नया प्रश्न शुरू करें"

msgid "State:"
msgstr "स्थिति:"

msgid "Status {status}"
msgstr "स्थिति {status}"

msgid "Take a photo of a nameplate or label"
msgstr "नेमप्लेट या लेबल की तस्वीर लें"

msgid "Text is being extracted from the document."
msgstr "दस्तावेज़ से पाठ निकाला जा रहा है।"

msgid "The document could not be fetched from that address."
msgstr "वह दस्तावेज़ उस पते से प्राप्त नहीं किया जा सका।"

msgid "The document could not be fetched from that address. Check that it is a public HTTPS link to a PDF or image, or upload the file instead."
msgstr "वह दस्तावेज़ उस पते से प्राप्त नहीं किया जा सका। जांचें कि यह एक सार्वजनिक HTTPS लिंक है जो PDF या छवि के लिए है, या इसके बजाय फ़ाइल अपलोड करें।"

msgid "The document is queued for extraction."
msgstr "दस्तावेज़ निष्कर्षण के लिए कतार में है।"

msgid "The document is stored and waiting for extraction."
msgstr "दस्तावेज़ संग्रहीत है और निष्कर्षण की प्रतीक्षा कर रहा है।"

msgid "The document was captured, but text could not be extracted. Review cannot start until extraction succeeds."
msgstr "दस्तावेज़ कैप्चर किया गया था, लेकिन पाठ निकाला नहीं जा सका। समीक्षा शुरू नहीं की जा सकती जब तक निष्कर्षण सफल न हो।"

msgid "The knowledge company is not configured."
msgstr "ज्ञान कंपनी कॉन्फ़िगर नहीं की गई है।"

msgid "The knowledge service could not complete this request."
msgstr "ज्ञान सेवा इस अनुरोध को पूरा नहीं कर सकी।"

msgid "The request did not complete within its time budget."
msgstr "अनुरोध अपने समय बजट के भीतर पूरा नहीं हुआ।"

msgid "The request was not valid."
msgstr "अनुरोध मान्य नहीं था।"

msgid "The review could not be saved. Check the fields and unresolved evidence."
msgstr "समीक्षा को सहेजा नहीं जा सका। फ़ील्ड और अनसुलझे साक्ष्य की जांच करें।"

msgid "The review service is unavailable. Nothing was changed."
msgstr "समीक्षा सेवा अनुपलब्ध है। कुछ भी नहीं बदला गया।"

msgid "The upload could not be captured."
msgstr "अपलोड को कैप्चर नहीं किया जा सका।"

msgid "The upload service is unavailable. The document was not captured."
msgstr "अपलोड सेवा अनुपलब्ध है। दस्तावेज़ कैप्चर नहीं किया गया था।"

msgid "This action is not configured for the library."
msgstr "यह क्रिया लाइब्रेरी के लिए कॉन्फ़िगर नहीं की गई है।"

msgid "This document changed since you opened it, or the same content was already reviewed. Reload and check before saving again."
msgstr "यह दस्तावेज़ तब से बदल गया है जब आपने इसे खोला था, या समान सामग्री पहले से ही समीक्षा की जा चुकी है। फिर से सहेजने से पहले पुनः लोड करें और जांच करें।"

msgid "This document changed while you were working. Reload it and try again."
msgstr "यह दस्तावेज़ आपके काम करते समय बदल गया। इसे पुनः लोड करें और फिर से कोशिश करें।"

msgid "This document is not available for review."
msgstr "यह दस्तावेज़ समीक्षा के लिए उपलब्ध नहीं है।"

msgid "This document version is not available."
msgstr "यह दस्तावेज़ संस्करण उपलब्ध नहीं है।"

msgid "This removes the manual from {sourceDisplayName} search and blocks its original version from download."
msgstr "यह मैनुअल को {sourceDisplayName} खोज से हटाता है और इसके मूल संस्करण को डाउनलोड से अवरुद्ध करता है।"

msgid "This review was published; it is now read-only."
msgstr "यह समीक्षा प्रकाशित की गई थी; यह अब केवल पढ़ने के लिए है।"

msgid "Title"
msgstr "शीर्षक"

msgid "Upload a manual"
msgstr "एक मैनुअल अपलोड करें"

msgid "Upload a manual, photograph a nameplate, or point at a public address. Access follows the library you choose."
msgstr "एक मैनुअल अपलोड करें, नेमप्लेट की तस्वीर लें, या एक सार्वजनिक पते की ओर इशारा करें। पहुंच आपके द्वारा चुनी गई लाइब्रेरी का अनुसरण करती है।"

msgid "Upload manual"
msgstr "मैनुअल अपलोड करें"

msgid "Valid review fields are required."
msgstr "वैध समीक्षा फ़ील्ड आवश्यक हैं।"

msgid "You are not allowed to add documents to the selected library."
msgstr "आप चयनित लाइब्रेरी में दस्तावेज़ जोड़ने की अनुमति नहीं दी गई है।"

msgid "You are not allowed to add documents to this library."
msgstr "आप इस लाइब्रेरी में दस्तावेज़ जोड़ने की अनुमति नहीं दी गई है।"

msgid "You are not allowed to publish in this library. The review was kept."
msgstr "आप इस लाइब्रेरी में प्रकाशित करने की अनुमति नहीं दी गई है। समीक्षा रखी गई थी।"

msgid "You are not allowed to review documents in this library."
msgstr "आप इस लाइब्रेरी में दस्तावेज़ की समीक्षा करने की अनुमति नहीं दी गई है।"

msgid "You are not signed in to this library, or your access was revoked."
msgstr "आप इस लाइब्रेरी में साइन इन नहीं हैं, या आपकी पहुंच रद्द कर दी गई थी।"

msgid "You cannot add documents to any library. Ask an administrator for a library grant."
msgstr "आप किसी भी लाइब्रेरी में दस्तावेज़ नहीं जोड़ सकते। लाइब्रेरी अनुदान के लिए प्रशासक से पूछें।"

msgid "You do not have permission for this action in this library."
msgstr "आपको इस लाइब्रेरी में इस क्रिया के लिए अनुमति नहीं है।"

msgid "Your access changed while this request ran. Search again."
msgstr "इस अनुरोध के चलते समय आपकी पहुंच बदल गई। फिर से खोजें।"
