{
  "$schema": "https://turborepo.org/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build", "//#lingui:compile"],
      "outputs": [
        "dist/**",
        "build/**",
        "api/**",
        ".vercel/**",
        "public/build/**",
        ".next/**",
        "!.next/cache/**"
      ]
    },
    "@carbon/documents#build": {
      "inputs": ["scripts/generate-fonts.mjs", "package.json"],
      "outputs": ["src/pdf/fonts.data.ts"]
    },
    "//#lingui:compile": {
      "inputs": ["lingui.config.js", "packages/locale/locales/**/*.po"],
      "outputs": ["packages/locale/locales/**/*.mjs"]
    },
    "test": {
      "cache": false,
      "dependsOn": ["^build", "//#generate:mcp"]
    },
    "test:integration": {
      "cache": false,
      "dependsOn": ["^build"]
    },
    "test:e2e": {
      "cache": false,
      "dependsOn": ["build"]
    },
    "typecheck": {
      "cache": false,
      "dependsOn": ["//#generate:mcp"]
    },
    "lint": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    },
    "clean": {
      "cache": false
    },
    "deploy": {
      "dependsOn": ["^build"],
      "cache": false
    },
    "db:types": {
      "outputs": [],
      "cache": true
    },
    "db:init": {
      "outputs": []
    },
    "db:migrate": {
      "outputs": [],
      "cache": false
    },
    "db:seed": {
      "outputs": [],
      "cache": false
    },
    "migration:new": {
      "cache": false,
      "outputs": ["migrations/**"]
    },
    "migrate:test": {
      "cache": false,
      "outputs": []
    },
    "generate:types": {
      "cache": false,
      "outputs": ["src/database.types.ts"]
    },
    "evaluate": {
      "cache": false,
      "outputs": []
    },
    "verify:security": {
      "cache": false,
      "outputs": []
    },
    "verify:deployment": {
      "cache": false,
      "outputs": []
    },
    "typegen": {
      "cache": false,
      "outputs": []
    },
    "//#generate:mcp": {
      "inputs": [
        "apps/erp/app/modules/*/*.service.ts",
        "apps/erp/app/modules/*/*.mcp.server.ts",
        "apps/erp/app/modules/*/*.models.ts",
        "apps/erp/app/routes/api+/mcp+/lib/mcp-blocked-tools.ts",
        "scripts/generate-mcp.ts",
        "scripts/lib/**"
      ],
      "outputs": [
        "apps/erp/app/routes/api+/mcp+/lib/tool-metadata.json",
        "apps/erp/app/routes/api+/mcp+/lib/tool-manifest.digest.json"
      ]
    },
    "erp#build": {
      "dependsOn": ["^build", "//#lingui:compile", "//#generate:mcp"]
    },
    "knowledge#build": {
      "dependsOn": ["^build"]
    },
    "knowledge-query#build": {
      "dependsOn": ["^build"]
    },
    "knowledge-worker#build": {
      "dependsOn": ["^build"]
    },
    "knowledge-actions#build": {
      "dependsOn": ["^build"]
    }
  }
}
