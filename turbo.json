    "@carbon/documents#build": {
      "inputs": ["scripts/generate-fonts.mjs", "package.json"],
      "outputs": ["src/pdf/fonts.data.ts"]
    },
    "//#lingui:compile": {
      "inputs": ["lingui.config.js", "packages/locale/locales/**/*.po"],
      "outputs": ["packages/locale/locales/**/*.mjs"]
    },
    "transit": {
      "dependsOn": ["^transit"],
      "inputs": ["$TURBO_DEFAULT$", "!**/AGENTS.md", "!**/CLAUDE.md"]
    },
    "test": {
      "dependsOn": ["^build", "transit"],
      "inputs": ["$TURBO_DEFAULT$", "!**/AGENTS.md", "!**/CLAUDE.md"],
      "outputs": []
    },
    "test:integration": {
      "cache": false,
      "dependsOn": ["^build"]
    },
    "test:e2e": {
      "cache": false,
      "dependsOn": ["build"]
    },
    "typecheck": {
      "dependsOn": ["transit"],
      "inputs": ["$TURBO_DEFAULT$", "!**/AGENTS.md", "!**/CLAUDE.md"],
      "outputs": [".react-router/types/**", ".source/**", "lib/*.generated.ts"]
    },
    "lint": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "!**/AGENTS.md",
        "!**/CLAUDE.md",
        "$TURBO_ROOT$/biome.jsonc"
      ],
      "outputs": []
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    },
    "clean": {
      "cache": false
    },
    "deploy": {
      "dependsOn": ["^build"],
      "cache": false
    },
    "db:types": {
      "outputs": [],
      "cache": true
    },
    "db:init": {
      "outputs": []
    },
    "db:migrate": {
      "outputs": [],
      "cache": false
    },
    "db:seed": {
      "outputs": [],
      "cache": false
    },
    "migration:new": {
      "cache": false,
      "outputs": ["migrations/**"]
    },
    "migrate:test": {
      "cache": false,
      "outputs": []
    },
    "generate:types": {
      "cache": false,
      "outputs": ["src/database.types.ts"]
    },
    "evaluate": {
      "cache": false,
      "outputs": []
    },
    "verify:security": {
      "cache": false,
      "outputs": []
    },
    "verify:deployment": {
      "cache": false,
      "outputs": []
    },
    "typegen": {
      "cache": false,
      "outputs": []
    },
    "//#generate:mcp": {
      "cache": false,
      "inputs": [
        "apps/erp/app/modules/**",
        "apps/erp/app/components/TreeView/**",
        "apps/erp/app/services/**",
        "apps/erp/app/types/**",
        "apps/erp/app/utils/**",
        "apps/erp/tsconfig.json",
        "packages/{account,api,auth,database,documents,ee,env,files,form,jobs,kv,lib,locale,logger,notifications,onboarding,planning,printing,react,stripe,utils}/src/**",
        "scripts/generate-mcp.ts",
        "scripts/lib/**"
      ],
      "outputs": [
        "apps/erp/app/routes/api+/mcp+/lib/tool-metadata.json",
        "apps/erp/app/routes/api+/mcp+/lib/tool-manifest.digest.json"
      ]
    },
    "erp#build": {
      "dependsOn": ["^build", "//#lingui:compile", "//#generate:mcp"]
    },
    "portal#build": {
      "dependsOn": ["^build"]
    },
    "portal-query#build": {
      "dependsOn": ["^build"]
    },
    "portal-worker#build": {
      "dependsOn": ["^build"]
    },
    "portal-actions#build": {
      "dependsOn": ["^build"]
    }
  }
}
